class Solution {
    public int numOfSubarrays(int[] arr) {
        int oddCount = 0;
        int evenCount = 1;
        int count = 0;
        int sum = 0;
        int n = arr.length;
        int mod = 1_000_000_007;
        for (int i = 0; i < n; i++) {
            sum += arr[i];
            if (sum % 2 == 0) {
                count = (count + oddCount) % mod;
                evenCount++;
            } else {
                count = (count + evenCount) % mod;
                oddCount++;

            }
        }
        return count;
    }
}
