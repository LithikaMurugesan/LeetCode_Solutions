class Solution {
    public int minElement(int[] nums) {

        int min = Integer.MAX_VALUE;

        for(int i = 0; i < nums.length; i++) {

            String str = String.valueOf(nums[i]);

            int sum = 0;

            for(int j = 0; j < str.length(); j++) {
                sum += str.charAt(j) - '0';
            }

            min = Math.min(min, sum);
        }

        return min;
    }
}
