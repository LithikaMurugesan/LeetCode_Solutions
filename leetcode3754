class Solution {
    public long sumAndMultiply(int n) {
        long x = 0;
        long sum = 0;
        String str = String.valueOf(n);
        for (int i = 0; i < str.length(); i++) {
            char chr = str.charAt(i);
            int a = chr - '0';
            sum += a;
            if (a > 0) {
                x = x * 10 + a;
            }
        }
        return x * sum;
    }
}
